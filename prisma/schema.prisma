generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Board {
  id    Int    @id @default(autoincrement())
  title String @unique
  lists List[]
}

model List {
  id      Int    @id @default(autoincrement())
  title   String
  order   Int
  boardId Int
  cards   Card[]
  board   Board  @relation(fields: [boardId], references: [id])
}

model Card {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  order       Int
  listId      Int
  list        List    @relation(fields: [listId], references: [id])
}
